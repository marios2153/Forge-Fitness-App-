# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Port the server listens on. The server also hosts the frontend (index.html, app.js, ...),
# so visiting this port in a browser opens the whole app.
PORT=8788

# Where verification links should point. Change this to your real domain once deployed
# (e.g. https://forge.yourdomain.com); leave as-is for local development.
PUBLIC_BASE_URL=http://localhost:8788

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left blank the server invents one at startup, which means every restart signs
# everyone out — fine for trying things out, not for real use.
JWT_SECRET=

# Gmail account that sends verification emails.
GMAIL_USER=pixelforgenetworks@gmail.com

# A Gmail App Password (NOT your normal Gmail password). Create one at
# https://myaccount.google.com/apppasswords — requires 2-Step Verification to be on
# for the pixelforgenetworks@gmail.com account. Paste the 16-character password here.
GMAIL_APP_PASSWORD=

# Stripe (Forge Premium subscriptions). Get keys from https://dashboard.stripe.com/apikeys —
# use the Test mode secret key while developing; switch to the Live key only when you're
# ready to take real payments.
STRIPE_SECRET_KEY=

# Recurring Price IDs from a "Forge Premium" Product in the Stripe Dashboard: Product catalog
# -> Add product -> add one monthly and one yearly recurring price (matching the €5.99/€64.69
# shown in the app, or your own amounts). Copy each price's ID — it starts with "price_", not
# the product ID which starts with "prod_".
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Signing secret for verifying incoming webhook events (subscription activated/renewed/
# cancelled) — without this, anyone could POST a fake "payment succeeded" event.
# Local dev: run `stripe listen --forward-to localhost:8788/api/webhooks/stripe` (Stripe CLI)
# and paste the whsec_... it prints.
# Production: create a webhook endpoint in the Stripe Dashboard pointing at
# https://yourdomain.com/api/webhooks/stripe, subscribed to checkout.session.completed,
# customer.subscription.updated and customer.subscription.deleted, then copy its signing
# secret here instead.
STRIPE_WEBHOOK_SECRET=

NODE_ENV=development
